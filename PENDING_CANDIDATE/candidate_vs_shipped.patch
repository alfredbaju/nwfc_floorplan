+def _macro_components(cells):
+    """4-connected components of a set of (row, col) macro cells."""
+    remaining = set(cells)
+    comps = []
+    while remaining:
+        start = remaining.pop()
+        comp = {start}
+        stack = [start]
+        while stack:
+            r, c = stack.pop()
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nb = (r + dr, c + dc)
+                if nb in remaining:
+                    remaining.remove(nb)
+                    comp.add(nb)
+                    stack.append(nb)
+        comps.append(comp)
+    return comps
+
