+def score_macro_plan(plan, A, B, room_counts, room_sizes, target_corridor_share=0.10,
+                     max_liv_share_with_balcony=0.30, compat=None):
+    """Score a macro room plan against the layout rules. LOWER IS BETTER.
+
+    The greedy planner places rooms one at a time and silently accepts
+    whatever it ends up with -- verified directly: a kitchen planned at
+    16 cells came out at 12, 12 and 1 cell across three seeds, and
+    kitchens regularly wrapped through the gaps between bedroom/bathroom
+    suites, touching them. Generating many cheap candidates and scoring
+    them against the actual rules is far more dependable than hoping the
+    greedy placement lands on a good arrangement.
+    """
+    cells_by_type = {}
+    for pos, rt in plan.items():
+        cells_by_type.setdefault(rt, set()).add(pos)
+
+    def nbrs(p):
+        r, c = p
+        return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+    total_cells = A * B
+    penalty = 0.0
+
+    # 1. Fulfilment: rooms must actually receive the space they were
+    #    sized for (a truncated kitchen/bedroom is the single worst
+    #    outcome -- the leftover space silently becomes corridor).
+    for rt in ("BED", "BATH", "KIT", "LIV", "BALC"):
+        want_each = room_sizes.get(rt, 1)
+        count = room_counts.get(rt, 0)
+        if count <= 0:
+            continue
+        comps = _macro_components(cells_by_type.get(rt, set()))
+        got_total = sum(len(c) for c in comps)
+        penalty += 6.0 * max(0, count * want_each - got_total)
+        # Two rooms of the same type touching merge into one at the
+        # tile level and break the exact count (verified: bathroom total
+        # came out 6 instead of 7), so a merged pair is heavily penalised.
+        penalty += 40.0 * max(0, count - len(comps))
+        if rt in ("BED", "KIT", "BALC"):
+            for comp in comps:
+                floor_size = 0.8 * want_each
+                if len(comp) < floor_size:
+                    penalty += 6.0 * (floor_size - len(comp))
+
+    # 2. Kitchen: a single clean zone, on the border, never touching
+    #    bedrooms/bathrooms (or living room), ideally in a corner and
+    #    far from the living room.
+    kit = cells_by_type.get("KIT", set())
+    if kit:
+        bed_bath = cells_by_type.get("BED", set()) | cells_by_type.get("BATH", set())
+        liv = cells_by_type.get("LIV", set())
+        contacts_bb = sum(1 for p in kit for nb in nbrs(p) if nb in bed_bath)
+        contacts_liv = sum(1 for p in kit for nb in nbrs(p) if nb in liv)
+        penalty += 8.0 * contacts_bb + 3.0 * contacts_liv
+        rows_ = [r for r, c in kit]
+        cols_ = [c for r, c in kit]
+        bbox = (max(rows_) - min(rows_) + 1) * (max(cols_) - min(cols_) + 1)
+        penalty += 12.0 * (1.0 - len(kit) / bbox)
+        penalty += 15.0 * max(0, len(_macro_components(kit)) - 1)
+        on_border = lambda p: p[0] in (0, A - 1) or p[1] in (0, B - 1)
+        if not any(on_border(p) for p in kit):
+            penalty += 30.0
+        if not any((p[0] in (0, A - 1)) and (p[1] in (0, B - 1)) for p in kit):
+            penalty += 3.0
+        if liv:
+            kr = sum(rows_) / len(kit)
+            kc = sum(cols_) / len(kit)
+            lr = sum(r for r, c in liv) / len(liv)
+            lc = sum(c for r, c in liv) / len(liv)
+            penalty += 4.0 * (1.0 - math.hypot(kr - lr, kc - lc) / math.hypot(A, B))
+
+    # 3. Every bathroom must sit against a bedroom (ensuite) whenever
+    #    there are enough bedrooms to go around.
+    if 0 < room_counts.get("BATH", 0) <= room_counts.get("BED", 0):
+        bed = cells_by_type.get("BED", set())
+        for comp in _macro_components(cells_by_type.get("BATH", set())):
+            if not any(nb in bed for p in comp for nb in nbrs(p)):
+                penalty += 20.0
+
+    # 4. Balconies belong on the exterior edge.
+    for p in cells_by_type.get("BALC", set()):
+        depth = min(p[0], A - 1 - p[0], p[1], B - 1 - p[1])
+        if depth > 0:
+            penalty += 4.0 * depth
+
+    # 5. Living room share cap on floors with balconies (upper floors).
+    if room_counts.get("BALC", 0) > 0:
+        liv_n = len(cells_by_type.get("LIV", set()))
+        cap = max_liv_share_with_balcony * total_cells
+        if liv_n > cap:
+            penalty += 4.0 * (liv_n - cap)
+
+    # 6. Corridor share close to target, and corridor must be one
+    #    connected network.
+    corridor = cells_by_type.get("CORRIDOR", set()) | cells_by_type.get("CORRIDOR_ENTRANCE", set())
+    penalty += 25.0 * abs(len(corridor) / total_cells - target_corridor_share)
+    penalty += 10.0 * max(0, len(_macro_components(corridor)) - 1)
+
+    # 7. Bedrooms should be reasonably proportioned.
+    for comp in _macro_components(cells_by_type.get("BED", set())):
+        rows_ = [r for r, c in comp]
+        cols_ = [c for r, c in comp]
+        h = max(rows_) - min(rows_) + 1
+        w = max(cols_) - min(cols_) + 1
+        ar = min(h, w) / max(h, w)
+        if ar < 0.5:
+            penalty += 12.0 * (0.5 - ar)
+
+    # 9. Seams between room types that are not allowed to share a door
+    #    (per the tileset's layer-2 matrix). VERIFIED to predict
+    #    tile-level failure: the exterior solver picks door edges
+    #    freely toward not-yet-generated neighbours, and when that
+    #    neighbour's type can't take a door it dead-ends and
+    #    backtracks. Balcony floors with 6+ such seams solved 0 of 8
+    #    times; with 3 or fewer, about 2 of 3. Balcony and stair are
+    #    the pickiest types, so this also keeps a balcony against
+    #    bedroom/living/corridor and a stair against corridor/living.
+    if compat is not None:
+        short = {"CORRIDOR": "COR", "CORRIDOR_ENTRANCE": "ENT"}
+        incompatible_seams = 0
+        for (r, c), rt in plan.items():
+            for dr, dc in ((1, 0), (0, 1)):
+                other = plan.get((r + dr, c + dc))
+                if other is None:
+                    continue
+                a, b = short.get(rt, rt), short.get(other, other)
+                if a != b and not (compat(a, b) and compat(b, a)):
+                    incompatible_seams += 1
+        penalty += 10.0 * incompatible_seams
+
+    # 8. Every bedroom and the kitchen should touch the corridor
+    #    network (that's how they connect to the rest of the floor).
+    for rt in ("BED", "KIT"):
+        for comp in _macro_components(cells_by_type.get(rt, set())):
+            if not any(nb in corridor for p in comp for nb in nbrs(p)):
+                penalty += 6.0
+
+    return penalty
+
