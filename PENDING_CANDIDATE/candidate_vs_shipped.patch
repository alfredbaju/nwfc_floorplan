+_ADAPTED_SIZE_CACHE = {}
+
+
+def _plan_shortfalls(plan, room_counts, sizes):
+    """{room_type: cells missing} for rooms that didn't receive the
+    space they were planned for."""
+    cells = {}
+    for pos, rt in plan.items():
+        cells[rt] = cells.get(rt, 0) + 1
+    out = {}
+    for rt in ("BED", "BATH", "KIT", "LIV", "BALC"):
+        count = room_counts.get(rt, 0)
+        if count <= 0:
+            continue
+        missing = count * sizes.get(rt, 1) - cells.get(rt, 0)
+        if missing > 0:
+            out[rt] = missing
+    return out
+
+
+def _adapt_sizes_to_fit(A, B, room_counts, sizes, kwargs, probe_seeds=16, max_rounds=14,
+                        min_bed_size=6, min_fraction=0.5):
+    """Shrink the flexible rooms' planned sizes until the planner can
+    actually deliver them in this grid.
+
+    The sizing formulas work from area percentages, but real placement
+    also needs space for bedroom/bathroom suites' unavoidable gaps, the
+    kitchen's corridor ring and the connecting corridor. Verified
+    directly: kitchen 16 + living 17 planned for a floor whose free
+    space (after three suites, ring and connecting corridor) holds
+    about half of that -- so the living room was silently truncated to
+    ~6 cells and the leftover became corridor. Probing the planner and
+    trimming only what doesn't fit keeps every room at a size it can
+    genuinely receive.
+    """
+    original = dict(sizes)
+    cur = dict(sizes)
+    for _ in range(max_rounds):
+        shortfall_runs = []
+        for i in range(probe_seeds):
+            try:
+                plan = plan_subgrid_assignment(A, B, room_counts, seed=1234567 + i * 7919,
+                                               **{**kwargs, "room_sizes": cur})
+            except ValueError:
+                continue
+            shortfall_runs.append(_plan_shortfalls(plan, room_counts, cur))
+        if shortfall_runs and any(not sf for sf in shortfall_runs):
+            return cur
+        if not shortfall_runs:
+            agg = {rt: 1 for rt in ("KIT", "LIV", "BALC", "BED")}
+        else:
+            agg = {}
+            for rt in ("BED", "BATH", "KIT", "LIV", "BALC"):
+                vals = sorted(sf.get(rt, 0) for sf in shortfall_runs)
+                agg[rt] = vals[len(vals) // 2]
+        changed = False
+        for rt in ("KIT", "LIV", "BALC"):
+            if agg.get(rt, 0) > 0 and room_counts.get(rt, 0) > 0:
+                floor_size = max(1, int(math.ceil(min_fraction * original.get(rt, 1))))
+                new_size = max(floor_size, cur[rt] - max(1, int(round(0.12 * cur[rt]))))
+                if new_size < cur[rt]:
+                    cur[rt] = new_size
+                    changed = True
+        # Keep the user's kitchen/living rule while adapting: kitchen
+        # and living room about the same size, living slightly larger.
+        # Kitchen is reserved first (so it nearly always gets its full
+        # size) which means only the living room tends to come up
+        # short -- without this, adapting alone would leave the
+        # kitchen much LARGER than the living room.
+        if room_counts.get("KIT", 0) > 0 and room_counts.get("LIV", 0) > 0:
+            max_kit = max(1, int(round(cur["LIV"] / 1.1)))
+            if cur["KIT"] > max_kit:
+                cur["KIT"] = max_kit
+                changed = True
+        if (agg.get("BED", 0) > 0 or agg.get("BATH", 0) > 0) and room_counts.get("BED", 0) > 0:
+            new_bed = max(min_bed_size, cur.get("BED", 6) - 1)
+            if new_bed < cur.get("BED", 6):
+                cur["BED"] = new_bed
+                cur["BATH"] = max(1, int(math.floor(new_bed * 0.40)))
+                changed = True
+        if not changed:
+            break
+    return cur
+
+
+def plan_subgrid_assignment_best(A, B, room_counts, seed=None, n_candidates=40, **kwargs):
+    """Generate several macro plans from derived seeds and return the
+    best-scoring one (see score_macro_plan). Macro planning is cheap
+    (a few ms per plan), so searching dozens of candidates costs far
+    less than a single tile-level WFC solve, and it means the rules
+    are checked against real outcomes instead of assumed.
+
+    Planned sizes are first adapted (once, then cached) so every room
+    is sized for space the planner can really give it.
+    """
+    compat = kwargs.pop("compat", None)
+    base = seed if seed is not None else random.randint(0, 10_000_000)
+    given_sizes = dict(kwargs.get("room_sizes") or ROOM_SIZE_SUBGRIDS)
+    forced_key = tuple(sorted((k, tuple(v)) for k, v in (kwargs.get("forced_positions") or {}).items()))
+    cache_key = (A, B, tuple(sorted(room_counts.items())), tuple(sorted(given_sizes.items())), forced_key,
+                 bool(kwargs.get("second_entrance_near_kitchen")))
+    sizes = _ADAPTED_SIZE_CACHE.get(cache_key)
+    if sizes is None:
+        sizes = _adapt_sizes_to_fit(A, B, room_counts, given_sizes, kwargs)
+        _ADAPTED_SIZE_CACHE[cache_key] = sizes
+    kwargs = {**kwargs, "room_sizes": sizes}
+    corridor_target = kwargs.get("corridor_target")
+    target_share = (corridor_target / (A * B)) if corridor_target else 0.10
+    best, best_score, last_err = None, None, None
+    for i in range(n_candidates):
+        s = (base * 1000003 + i * 7919) % 2_147_483_647
+        try:
+            plan = plan_subgrid_assignment(A, B, room_counts, seed=s, **kwargs)
+        except ValueError as e:
+            last_err = e
+            continue
+        sc = score_macro_plan(plan, A, B, room_counts, sizes, target_corridor_share=max(0.10, target_share),
+                              compat=compat)
+        if best is None or sc < best_score:
+            best, best_score = plan, sc
+    if best is None:
+        raise last_err if last_err else ValueError("No feasible macro plan found")
+    return best
+
